#!/usr/bin/env python3
"""llmwiki — 知识库体系与文档站 CLI（`llm-wiki` skill）

判据见 ../SKILL.md；项目配置见项目根 `.llm-wiki.toml`（模板见 ../TEMPLATE.md）。

本体 **stdlib-only**；`build` / `serve` / `pdf` 三个子命令**调用**外部工具
（`mkdocs` / `mmdc`），不内嵌。判据类命令（`nav` / `lint` / `drift` / `export`）零依赖。

用法：
  llmwiki check-deps                    校验 mkdocs 及插件（含主版本硬上限）
  llmwiki build [--strict]              构建站点
  llmwiki deploy [目录] [--force]        构建（strict）并部署到目录（默认 <项目根>/dist）
  llmwiki serve [start|stop|status] [--full] [--with-dates] [--port N]
  llmwiki nav build                     由目录生成导航 .pages（落实 P4）
  llmwiki lint [--semantic] [--max N]   体检：目录预算 / 断链 / 孤儿 [＋语义]
  llmwiki drift                         上游仓演进 vs 我方分析篇的时差
  llmwiki export [--llms-txt] [--out F] 生成 AI 可消费出口
  llmwiki pdf <src> <outdir> <stem>     mermaid → PNG 中转（供 md→pdf）

项目根定位顺序：`--root` → `LLMWIKI_ROOT` 环境变量 → 向上自动查找。
自动查找按标记**分轮**（`.llm-wiki.toml` → `mkdocs.yml` → `.git`），避免 monorepo
内嵌小仓里锁错根（详 `find_root()`）。
"""
from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:                      # pragma: no cover
    tomllib = None

DEFAULTS: dict[str, object] = {
    "site.root": "docs",
    "site.site_dir": "site",
    "site.config": "mkdocs.yml",
    "site.port": 8000,
    "site.nav_mode": "auto",                     # auto=P4 由目录生成 .pages
    "lint.max_children": 24,
    "lint.broken_links": True,
    "lint.orphans": True,
    "lint.nav_coverage": True,                   # auto 模式下检查 `.pages` 空 nav（导航可达性）
    "lint.ignore": [".tmp", "archive", "node_modules", ".git"],
    "export.llms_txt": False,
}

#: 站点依赖的**主版本硬上限**：MkDocs 2.0 移除插件系统、重写主题，
#: 依赖 plugins（search / git-revision-date）与 material 主题的站点不能被升上去。
MAX_MAJOR = {"mkdocs": 1}


# ─────────────────────────── 配置与项目定位 ───────────────────────────
def find_root(start: Path | None = None) -> Path:
    """向上找项目根，按标记类型**分轮**扫描（近的弱标记不得盖过远的强标记）。

    轮次：① `.llm-wiki.toml`（显式配置）② `mkdocs.yml`（站点配置）③ `.git`（最后手段）。
    分轮而非「三者任一即返回」，是为了比赛 monorepo 内嵌小仓：内嵌仓有 `.git` 但
    通常无配置，若与 `mkdocs.yml` 同权，在小仓子目录里执行就会锁到小仓、静默用错配置。
    """
    cur = (start or Path.cwd()).resolve()
    candidates = [cur, *cur.parents]
    for marker in (".llm-wiki.toml", "mkdocs.yml", ".git"):
        for d in candidates:
            if (d / marker).exists():
                return d
    return cur


def flatten(doc: dict, prefix: str = "") -> dict:
    out = {}
    for k, v in doc.items():
        key = f"{prefix}{k}"
        if isinstance(v, dict):
            out.update(flatten(v, key + "."))
        else:
            out[key] = v
    return out


def load_cfg(root: Path, cli_port: int | None = None) -> dict:
    cfg = dict(DEFAULTS)
    f = root / ".llm-wiki.toml"
    if f.exists():
        if tomllib is None:
            die("需要 Python 3.11+ 才能解析 .llm-wiki.toml")
        cfg.update(flatten(tomllib.loads(f.read_text(encoding="utf-8"))))
    cfg["_root"] = root
    cfg["_watch"] = (tomllib.loads(f.read_text(encoding="utf-8"))
                     .get("drift", {}).get("watch", [])) if (tomllib is not None and f.exists()) else []
    if cli_port:
        cfg["site.port"] = cli_port
    return cfg


def _root_from_env() -> Path | None:
    """`LLMWIKI_ROOT` 环境变量（可在脚本／多仓目录里显式钉死项目根）。"""
    env = os.environ.get("LLMWIKI_ROOT")
    if not env:
        return None
    p = Path(env).expanduser()
    if not p.is_dir():
        die(f"LLMWIKI_ROOT 指向的目录不存在：{p}")
    return p.resolve()


def docs_dir(cfg: dict) -> Path:
    return cfg["_root"] / str(cfg["site.root"])


def die(msg: str, code: int = 1):
    print(f"✗ {msg}", file=sys.stderr)
    sys.exit(code)


def skip(rel: Path, cfg: dict) -> bool:
    """按 `lint.ignore` 判定是否跳过。两类模式：

      - **单段名**（如 `archive`）：出现在路径任一层即跳过；
      - **子路径前缀**（如 `asset/tb2-mdm/raw`）：该前缀及其下全部跳过。

    典型用途：源层素材目录（原始导出／单据／截图集）不参与 P1 目录预算
    ——P1 只管「编译层的可读文档」，素材不是给人读的。
    """
    s = rel.as_posix()
    for pat in cfg["lint.ignore"]:
        if pat in rel.parts or s == pat or s.startswith(pat + "/"):
            return True
    return False


# ─────────────────────────── check-deps / build / serve ───────────────────────────
DEPS = ["mkdocs", "mkdocs-material", "mkdocs-git-revision-date-localized-plugin"]
#: `nav build` 产物的唯一消费者——`nav_mode=auto` 时属必需，其他模式仅提示
NAV_DEPS = ["mkdocs-awesome-pages-plugin"]


def _too_new(pkg: str, cap: int) -> str | None:
    try:
        import importlib.metadata as md
        ver = md.version(pkg)
    except Exception:
        return None
    m = re.match(r"(\d+)", ver)
    if m and int(m.group(1)) > cap:
        return f"{pkg} {ver} 超出主版本上限 {cap}（{MAX_MAJOR.get(pkg)}）"
    return None


def cmd_check_deps(cfg, a):
    auto = str(cfg.get("site.nav_mode", "manual")) == "auto"
    deps = DEPS + (NAV_DEPS if auto else [])
    missing, bad = [], []
    for pkg in deps:
        try:
            import importlib.metadata as md
            md.version(pkg)
        except Exception:
            missing.append(pkg)
    if not auto:
        try:
            import importlib.metadata as md
            print(f"· nav_mode=manual：{NAV_DEPS[0]} {md.version(NAV_DEPS[0])}（已装，非必需）")
        except Exception:
            pass
    for pkg, cap in MAX_MAJOR.items():
        if pkg not in missing and (msg := _too_new(pkg, cap)):
            bad.append(msg)
    if missing:
        print(f"缺少依赖: {', '.join(missing)}")
        print(f"安装: {sys.executable} -m pip install {' '.join(missing)}")
    for b in bad:
        print(f"⚠ {b}")
    if not missing and not bad:
        print("依赖齐全")
    return 0 if not missing and not bad else 1


def _mkdocs_env(cfg: dict, with_dates: bool = True) -> dict:
    """mkdocs 运行环境。

    `DOCS_GIT_REVISION` 控制「最后更新日期」插件：**必须 unset 而不是传 \"false\"**
    ——插件把值当字符串判真假，"false" 也会被当成开（实测坑）。
    """
    env = dict(os.environ)
    if with_dates:
        env["DOCS_GIT_REVISION"] = "true"
    else:
        env.pop("DOCS_GIT_REVISION", None)
    return env


def cmd_build(cfg, a):
    cmd = [sys.executable, "-m", "mkdocs", "build",
           "-f", str(cfg["site.config"])]
    if a.strict:
        cmd.append("--strict")
    print("构建中（约 30–60s，无输出属正常）…", flush=True)
    rc = subprocess.run(cmd, cwd=cfg["_root"], env=_mkdocs_env(cfg)).returncode
    if rc != 0:
        die("构建失败", rc)
    print(f"已构建: {cfg['site.site_dir']}/")
    return 0


#: 部署标记：目标目录里出现它 = 上次就是本工具写的，重部署无需 `--force`
DEPLOY_MARKER = ".llmwiki-deploy"


def _deploy_dest(cfg: dict, dest: str | None, force: bool) -> tuple[Path, bool]:
    """返回 `(目标目录, 是否需先清空)`；不合规目标直接 `die()`。

    **绝对拒绝**（`--force` 也不能越过）：文件系统根、`$HOME` 及其祖先、项目根及其祖先；
    目标落在知识库根或构建产物目录内部（会污染文档／删掉构建源）。
    目标已存在且非空时：仅当带本工具标记（上次部署）或给了 `--force` 才允许覆盖。
    """
    root = cfg["_root"].resolve()
    target = Path(dest).expanduser().resolve() if dest else (root / "dist")
    home = Path.home().resolve()
    docs = docs_dir(cfg).resolve()
    src = (root / str(cfg["site.site_dir"])).resolve()

    if target == target.parent:
        die(f"拒绝：{target} 是文件系统根")
    for label, p in (("$HOME", home), ("项目根", root)):
        if target == p or target in p.parents:
            die(f"拒绝：{target} 是 {label} 本身或其祖先")
    for label, p in (("知识库根", docs), ("构建产物目录", src)):
        if target == p or p in target.parents:
            die(f"拒绝：{target} 在 {label} 内部（{p}）")

    if not target.exists():
        return target, False
    if not target.is_dir():
        die(f"拒绝：{target} 已存在且不是目录")
    others = [e for e in target.iterdir() if e.name != DEPLOY_MARKER]
    if (target / DEPLOY_MARKER).exists() or not others:
        return target, True
    if not force:
        die(f"拒绝：{target} 已存在且非空（无 {DEPLOY_MARKER} 标记）；确认要覆盖请加 --force")
    return target, True


def cmd_deploy(cfg, a):
    """构建（strict）并复制产物到目标目录。"""
    dest, clear = _deploy_dest(cfg, a.dest, a.force)
    cmd = [sys.executable, "-m", "mkdocs", "build", "-f", str(cfg["site.config"]), "--strict"]
    print("构建中（strict）…", flush=True)
    if subprocess.run(cmd, cwd=cfg["_root"], env=_mkdocs_env(cfg)).returncode != 0:
        die("构建失败")
    src = cfg["_root"] / str(cfg["site.site_dir"])
    if not src.exists():
        die(f"构建产物不存在：{src}")
    if clear:
        shutil.rmtree(dest)
    dest.mkdir(parents=True, exist_ok=True)
    shutil.copytree(src, dest, dirs_exist_ok=True)
    (dest / DEPLOY_MARKER).write_text(f"{src}\n", encoding="utf-8")
    print(f"✓ 已部署 {src} → {dest}")
    return 0


def _pidfile(cfg: dict) -> Path:
    return Path(f"/tmp/llmwiki-{cfg['_root'].name}.pid")


def _port_alive(port: int) -> int | None:
    # 注意：`lsof -ti tcp:<port>` 是宽匹配（含客户端）⇒ 会连坐误杀；必须限定 LISTEN。
    out = subprocess.run(["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"],
                         capture_output=True, text=True).stdout.split()
    return int(out[0]) if out else None


def _wait_ready(port: int, child: subprocess.Popen, timeout: int = 90) -> bool:
    end = time.time() + timeout
    while time.time() < end:
        if child.poll() is not None:
            return False
        try:
            urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=2)
            return True
        except Exception:
            time.sleep(0.5)
    return False


def cmd_serve(cfg, a):
    port = int(a.port or cfg["site.port"])
    action = a.action or "start"
    if action == "status":
        pid = _port_alive(port)
        print(f"运行中: http://127.0.0.1:{port} (pid {pid})" if pid else "未运行")
        return 0
    if action == "stop":
        pid = _port_alive(port)
        if not pid:
            print("未运行")
            return 0
        os.kill(pid, 15)
        print(f"已停止 (pid {pid})")
        return 0
    # start
    if _port_alive(port):
        die(f"端口 {port} 已被占用")
    cmd = [sys.executable, "-m", "mkdocs", "serve",
           "-f", str(cfg["site.config"]), "-a", f"127.0.0.1:{port}"]
    if not a.full:
        cmd.append("--dirty")                     # 增量：改一个 md ~0.2s
    log = open(f"/tmp/llmwiki-{cfg['_root'].name}.log", "w")
    child = subprocess.Popen(cmd, cwd=cfg["_root"], env=_mkdocs_env(cfg, with_dates=a.with_dates),
                             stdout=log, stderr=subprocess.STDOUT)
    _pidfile(cfg).write_text(str(child.pid))
    print(f"启动中… 首次构建约 10–40s（日志 {log.name}）")
    print(f"就绪: http://127.0.0.1:{port}" if _wait_ready(port, child)
          else "⚠ 超时未就绪，请查看日志")
    return 0


# ─────────────────────────── nav build（P4） ───────────────────────────
def _h1(path: Path) -> str | None:
    try:
        for ln in path.read_text(encoding="utf-8").splitlines():
            if ln.startswith("# "):
                return ln[2:].strip()
    except Exception:
        pass
    return None


_NAV_KEY_RE = re.compile(r"^(\s*)nav\s*:\s*(\[\s*\]\s*)?$")


def _has_nav_items(lines: list[str], i: int, indent: int) -> bool:
    """`lines[i]` 是 `nav:` 行时，其后是否存在更深缩进的列表项。"""
    for ln in lines[i + 1:]:
        if not ln.strip() or ln.lstrip().startswith("#"):
            continue
        return len(ln) - len(ln.lstrip()) > indent and ln.lstrip().startswith("-")
    return False


def _empty_nav_at(text: str) -> int | None:
    """返回第一处**空 nav** 的行号（`nav: []` 或裸 `nav:` 且无列表项），没有则 `None`。"""
    lines = text.splitlines()
    for i, ln in enumerate(lines):
        m = _NAV_KEY_RE.match(ln)
        if m and not _has_nav_items(lines, i, len(m.group(1))):
            return i
    return None


def _drop_empty_nav(text: str) -> str:
    """删除**空** `nav` 键；非空 `nav` 原样保留（行级处理，不引入 YAML 依赖）。"""
    lines = text.splitlines()
    keep = []
    for i, ln in enumerate(lines):
        m = _NAV_KEY_RE.match(ln)
        if m and not _has_nav_items(lines, i, len(m.group(1))):
            continue
        keep.append(ln)
    return "\n".join(keep)


def _set_title(text: str, title: str) -> str:
    """设置顶层 `title` 键：存在即替换，不存在即前置。"""
    lines = text.splitlines()
    for i, ln in enumerate(lines):
        if re.match(r"^title\s*:", ln):
            lines[i] = f"title: {title}"
            return "\n".join(lines)
    return "\n".join([f"title: {title}", *lines])


def render_pages(directory: Path) -> str | None:
    """目录 → `.pages` 应写入的内容；`None` ＝ **不写盘**（交给 awesome-pages 自动列子项）。

    语义要点（P0-2 教训）：`.pages` 里的**空 `nav: []` 会让 awesome-pages 丢弃该目录
    全部子项**（只有 `meta.nav is None` 才自动列出），因此这里**绝不**用空 nav 当占位。
    没有 `index.md`（或它没有 H1）时就只剩「去掉空 nav、保留手写键」这一件事，
    结果为空即返回 `None`，由调用方决定是否删掉存量文件。

    写入是**合并**而非重写：只增改顶层 `title`，只删空 `nav`，其余键（`hide`/`collapse`
    ／非空 `nav` …）原样保留。
    """
    pages = directory / ".pages"
    text = _drop_empty_nav(pages.read_text(encoding="utf-8") if pages.exists() else "")
    index = directory / "index.md"
    if index.exists() and (title := _h1(index)):
        text = _set_title(text, title)
    text = text.strip()
    return text + "\n" if text else None


def cmd_nav_build(cfg, a):
    """为每个目录生成/刷新 `.pages`（MkDocs awesome-pages 插件读），使**目录即导航**。"""
    root = docs_dir(cfg)
    if not root.exists():
        die(f"知识库根不存在：{root}")
    writes: list[tuple[Path, str]] = []
    deletes: list[Path] = []
    for d in sorted([root, *[p for p in root.rglob("*") if p.is_dir()]]):
        if skip(d.relative_to(root), cfg):
            continue
        pages = d / ".pages"
        body = render_pages(d)
        if body is None:
            if pages.exists():            # 存量空 nav（或已空）⇒ 清掉，让子项回到导航
                deletes.append(pages)
            continue
        if not any(f.suffix == ".md" for f in d.iterdir() if f.is_file()):
            continue                      # 纯容器目录：不为它新建 .pages
        if pages.exists() and pages.read_text(encoding="utf-8") == body:
            continue
        writes.append((pages, body))
    if deletes:
        print(f"将清理 {len(deletes)} 个空 nav 的 .pages（其下页面重新回到导航）：")
        for p in deletes:
            print(f"  DELETE {p.relative_to(root).as_posix()}")
        if not a.dry_run:
            for p in deletes:
                p.unlink()
    if a.dry_run:
        for p, body in writes:
            print(f"（dry-run）WRITE {p.relative_to(root).as_posix()}  {body.splitlines()[0]}")
        print(f"（dry-run 结束）计划写 {len(writes)} / 清理 {len(deletes)}")
        return 0
    for p, body in writes:
        p.write_text(body, encoding="utf-8")
    print(f"✓ 已生成/刷新 {len(writes)} 个 .pages，清理 {len(deletes)} 个空 nav（目录即导航）")
    return 0


# ─────────────────────────── lint ───────────────────────────
LINK_RE = re.compile(r"\[[^\]]*\]\(([^)#\s]+)(?:#[^)]*)?\)")


def _collect_md(root: Path, cfg: dict) -> list[Path]:
    return [p for p in sorted(root.rglob("*.md")) if not skip(p.relative_to(root), cfg)]


def _lint_budget(root: Path, cfg: dict, max_children: int) -> list[str]:
    """P1 目录预算：任一目录直接子项 ≤ N。"""
    out = []
    for d in [root, *[p for p in root.rglob("*") if p.is_dir()]]:
        if skip(d.relative_to(root), cfg):
            continue
        kids = [f for f in d.iterdir()
                if not f.name.startswith(".") and not (f.is_dir() and skip(f.relative_to(root), cfg))]
        if len(kids) > max_children:
            out.append(f"[P1] {d.relative_to(root)} 直接子项 {len(kids)} > {max_children}（需分组）")
    return out


def _lint_links(root: Path, files: list[Path]) -> list[str]:
    out = []
    for f in files:
        text = f.read_text(encoding="utf-8")
        for target in LINK_RE.findall(text):
            if target.startswith(("http://", "https://", "mailto:", "#", "/")):
                continue
            dest = (f.parent / target.split("?")[0]).resolve()
            if not dest.exists():
                out.append(f"[断链] {f.relative_to(root)} → {target}")
    return out


#: 规范页永不进站，不需被链接——孤儿检查跳过
_ORPHAN_SKIP = re.compile(r"^(AGENTS|CLAUDE)\.md$")

#: 从 `mkdocs.yml` 的 nav 提取页面路径。两种写法都要认：
#: `- 标题: 路径.md`（`_NAV_RE`）与 MkDocs 允许的裸形式 `- 路径.md`（`_NAV_BARE_RE`）。
_NAV_RE = re.compile(r":\s*(\S+\.md)\s*$", re.M)
_NAV_BARE_RE = re.compile(r"^\s*-\s+(\S+\.md)\s*$", re.M)


def nav_paths(cfg: dict) -> set[str]:
    """nav 里列出的页面路径（相对知识库根）——列出即算「被引用」。"""
    f = cfg["_root"] / str(cfg["site.config"])
    if not f.exists():
        return set()
    text = f.read_text(encoding="utf-8")
    return set(_NAV_RE.findall(text)) | set(_NAV_BARE_RE.findall(text))


def _lint_orphans(root: Path, files: list[Path], nav: set[str] | None = None) -> list[str]:
    nav = nav or set()
    referenced: set[Path] = set()
    for f in files:
        for target in LINK_RE.findall(f.read_text(encoding="utf-8")):
            if target.startswith(("http", "mailto:", "#", "/")):
                continue
            dest = (f.parent / target.split("?")[0]).resolve()
            referenced.add(dest)
            if dest.is_dir():
                referenced.add(dest / "index.md")
    out = []
    for f in files:
        if f.name == "index.md" or _ORPHAN_SKIP.match(f.name):
            continue
        if f.relative_to(root).as_posix() in nav:       # nav 列出即算被引用
            continue
        if f.resolve() not in referenced:
            out.append(f"[孤儿] {f.relative_to(root)}（无页面链接它，也不在 nav）")
    return out


def _pages_empty_nav(pages: Path) -> bool:
    return _empty_nav_at(pages.read_text(encoding="utf-8")) is not None


def _lint_nav(root: Path, cfg: dict) -> list[str]:
    """导航可达性（P0-3）：`nav_mode=auto` 下「目录即导航」的前提是 `.pages` 不隐藏子项。

    只报**机械可判**的信号：`.pages` 里的空 `nav`（awesome-pages 会丢弃该目录全部子项）。
    若是有意隐藏，正解是显式声明（或把目录加入 `lint.ignore`），而不是空 nav。
    """
    out: list[str] = []
    hidden: set[Path] = set()
    for pages in sorted(root.rglob(".pages")):
        d = pages.parent
        if skip(d.relative_to(root), cfg) or not _pages_empty_nav(pages):
            continue
        n = len([p for p in d.rglob("*.md") if not skip(p.relative_to(root), cfg)])
        hidden.update(p for p in d.rglob("*.md") if not skip(p.relative_to(root), cfg))
        out.append(f"[导航] {pages.relative_to(root).as_posix()} 的 nav 为空 ⇒ 其下 {n} 个页面"
                   f"从侧边栏消失（有意隐藏请显式声明，或把该目录加入 lint.ignore）")
    total = len(_collect_md(root, cfg))
    print(f"· 导航覆盖 {total - len(hidden)}/{total} 页"
          f"{f'（{len(hidden)} 页被空 nav 隐藏）' if hidden else ''}")
    return out


def _nav_hint(cfg: dict) -> None:
    """提示 MkDocs 原生兜底：`validation.nav.omitted_files` 能抓住任何形式的「页面掉出导航」。"""
    f = cfg["_root"] / str(cfg["site.config"])
    if not f.exists() or "omitted_files" in f.read_text(encoding="utf-8"):
        return
    print("· 提示：可在 mkdocs.yml 声明 `validation.nav.omitted_files`（warn 级），"
          "让 MkDocs 原生兜住「既不在 nav 也不在 not_in_nav」的页面")


def _lint_semantic(root: Path, files: list[Path]) -> list[str]:
    """语义层（启发式）：**待确认/过期标记密度**。

    判据刻意保守——只报**机械可判**的信号，避免噪声。此处**不做**跨页一致性检测
    （那需语义理解，机械判必出误报）；「语义」仅指「非结构类信号」。
    """
    out = []
    stale_re = re.compile(r"(待确认|TODO|FIXME|过期|已失效|待补)", re.I)
    for f in files:
        text = f.read_text(encoding="utf-8")
        n = len(stale_re.findall(text))
        if n >= 3:
            out.append(f"[过时] {f.relative_to(root)} 含 {n} 处待确认/过期标记（应清理或转成开放项）")
    return out


def cmd_lint(cfg, a):
    root = docs_dir(cfg)
    if not root.exists():
        die(f"知识库根不存在：{root}")
    files = _collect_md(root, cfg)
    problems: list[str] = []
    max_children = a.max if a.max is not None else int(cfg["lint.max_children"])
    if max_children:
        problems += _lint_budget(root, cfg, max_children)
    if cfg["lint.broken_links"]:
        problems += _lint_links(root, files)
    auto = str(cfg.get("site.nav_mode", "manual")) == "auto"
    if cfg["lint.orphans"]:
        if auto:
            # P4（结构即导航）：所有 md 默认进导航 ⇒「孤儿」判据不适用；
            # 但「默认进导航」的前提是 .pages 不隐藏子项 —— 由下面的导航可达性检查兜住。
            print("· nav_mode=auto（P4）：孤儿检查不适用，改为导航可达性检查")
        else:
            problems += _lint_orphans(root, files, nav_paths(cfg))
    elif auto:
        print("· nav_mode=auto（P4）：孤儿检查已由配置关闭")
    if cfg.get("lint.nav_coverage"):
        problems += _lint_nav(root, cfg)
    if auto:
        _nav_hint(cfg)
    if a.semantic or cfg.get("lint.semantic"):
        problems += _lint_semantic(root, files)
    for p in problems:
        print(f"⚠ {p}")
    print(f"—— 扫描 {len(files)} 个 md / 问题 {len(problems)}"
          f"{'（含语义层）' if (a.semantic or cfg.get('lint.semantic')) else ''}")
    return 1 if problems else 0


# ─────────────────────────── drift ───────────────────────────
def _git_last_commit(path: Path, subpath: str = ".") -> int | None:
    """`path` 中 `subpath` 下的最后一次 commit 时间。限子路径可避开整仓噪声
    （上游大仓里一个无关的构建提交不该算作「分析篇过期」）。"""
    r = subprocess.run(["git", "-C", str(path), "log", "-1", "--format=%ct", "--", subpath],
                       capture_output=True, text=True)
    return int(r.stdout.strip()) if r.stdout.strip().isdigit() else None


def cmd_drift(cfg, a):
    watches = cfg.get("_watch") or []
    if not watches:
        print("（未配置 drift.watch；在 .llm-wiki.toml 里加 [[drift.watch]]）")
        return 0
    out = 0
    for w in watches:
        up = cfg["_root"] / w["upstream"]
        an = cfg["_root"] / w["analysis"]
        if not up.exists() or not an.exists():
            print(f"⚠ 路径不存在：{w['upstream']} 或 {w['analysis']}")
            out += 1
            continue
        subs = [up / p for p in (w.get("paths") or [])] or [up]
        stamps = [t for t in (_git_last_commit(p) for p in subs) if t is not None]
        t_up, t_an = (max(stamps) if stamps else None), _git_last_commit(an)
        if t_up is None or t_an is None:
            print(f"⚠ {w['upstream']}：无法读取 git 时间（非 git 仓？paths 写错？）")
            out += 1
            continue
        if t_up > t_an:
            days = (t_up - t_an) // 86400
            print(f"⚠ [漂移] {w['analysis']} 比上游 {w['upstream']} 落后 {days} 天（上游有更新）")
            out += 1
        else:
            print(f"= {w['analysis']} 与上游同步")
    print(f"—— watch {len(watches)} 项 / 漂移 {out}")
    return 1 if out else 0


# ─────────────────────────── export / pdf ───────────────────────────
def _frontmatter_description(path: Path) -> str | None:
    """取 YAML frontmatter 的 `description:`——行级提取，不引入 YAML 依赖。"""
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    for ln in lines[1:]:
        if ln.strip() == "---":
            return None
        m = re.match(r"^description\s*:\s*(.+?)\s*$", ln)
        if m:
            return m.group(1).strip().strip("\"'")
    return None


def _body_lines(path: Path) -> list[str]:
    """去掉 YAML frontmatter 之后的正文行。"""
    lines = path.read_text(encoding="utf-8").splitlines()
    if lines and lines[0].strip() == "---":
        for i, ln in enumerate(lines[1:], 1):
            if ln.strip() == "---":
                return lines[i + 1:]
    return lines


def _first_paragraph(path: Path) -> str | None:
    """首个非标题／非引用／非围栏代码的正文行。"""
    in_fence = False
    for ln in _body_lines(path):
        s = ln.strip()
        if s.startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence or not s or s[0] in "#>|!-*":
            continue
        return s
    return None


def _summary(path: Path, limit: int = 120) -> str:
    text = " ".join((_frontmatter_description(path) or _first_paragraph(path) or "").split())
    return text[:limit] + ("…" if len(text) > limit else "")


def cmd_export(cfg, a):
    root = docs_dir(cfg)
    files = _collect_md(root, cfg)
    if not (a.llms_txt or cfg["export.llms_txt"]):
        print("（未指定出口格式；试试 --llms-txt，或在 .llm-wiki.toml 置 export.llms_txt = true）")
        return 0
    lines = [f"# {cfg['_root'].name}", ""]
    for f in files:
        rel = f.relative_to(root)
        title = _h1(f) or f.stem
        s = _summary(f) if a.summary else ""
        lines.append(f"- [{title}]({rel.as_posix()})" + (f" — {s}" if s else ""))
    out = Path(a.out) if a.out else (root / "llms.txt")
    out.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"✓ 已导出 {out}（{len(files)} 条）")


PDF_THEME_MAP = {"monokai-warm": "dark", "dracula-soft": "dark"}


def _pdf_theme_map(cfg: dict) -> dict:
    """默认映射 ＋ `.llm-wiki.toml` 覆盖（配置优先）。

    注意 `flatten()` 会把 `[pdf.theme_map]` 摊成 `pdf.theme_map.<name>` **前缀键**，
    所以这里做前缀扫描而不是整键取值——否则配置永远读不到。
    """
    cfg_map = {k[len("pdf.theme_map."):]: v
               for k, v in cfg.items() if k.startswith("pdf.theme_map.")}
    return {**PDF_THEME_MAP, **cfg_map}


def cmd_pdf(cfg, a):
    theme = a.mermaid_theme or _pdf_theme_map(cfg).get(a.pdf_theme, "default")
    out = Path(a.outdir)
    out.mkdir(parents=True, exist_ok=True)
    text = Path(a.src).read_text(encoding="utf-8")
    idx = 0

    def repl(m):
        nonlocal idx
        idx += 1
        mmd = out / f"{a.stem}-{idx}.mmd"
        png = (out / f"{a.stem}-{idx}.png").resolve()
        mmd.write_text(m.group(1).strip() + "\n", encoding="utf-8")
        subprocess.run(["mmdc", "-i", str(mmd), "-o", str(png), "-b", "transparent",
                        "-s", "2", "-t", theme], check=True, capture_output=True)
        return f"![图{idx}]({png})"

    new = re.sub(r"```mermaid\n(.*?)```", repl, text, flags=re.S)
    dest = out / f"{a.stem}.pdf.md"
    dest.write_text(new, encoding="utf-8")
    print(f"replaced {idx} diagrams -> {dest}")


# ─────────────────────────── 入口 ───────────────────────────
def build_parser() -> argparse.ArgumentParser:
    """命令面真源——`SKILL.md` §6 的命令表以它为准（测试双向断言）。"""
    ap = argparse.ArgumentParser(prog="llmwiki", description="知识库体系与文档站 CLI")
    ap.add_argument("--root", help="项目根（默认依次取 LLMWIKI_ROOT、向上自动查找）")
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("check-deps").set_defaults(fn=cmd_check_deps)

    p = sub.add_parser("build"); p.add_argument("--strict", action="store_true")
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("deploy")
    p.add_argument("dest", nargs="?", help=f"目标目录（默认 <项目根>/dist）")
    p.add_argument("--force", action="store_true",
                   help=f"目标已存在且非空、又无 {DEPLOY_MARKER} 标记时，确认覆盖")
    p.set_defaults(fn=cmd_deploy)

    p = sub.add_parser("serve")
    p.add_argument("action", nargs="?", choices=["start", "stop", "status"], default="start")
    p.add_argument("--full", action="store_true", help="全量构建（增删页/改 nav 后用）")
    p.add_argument("--with-dates", action="store_true", help="预览时也启用最后更新日期（慢）")
    p.add_argument("--port", type=int)
    p.set_defaults(fn=cmd_serve)

    p = sub.add_parser("nav"); p.add_argument("action", choices=["build"])
    p.add_argument("--dry-run", action="store_true"); p.set_defaults(fn=cmd_nav_build)

    p = sub.add_parser("lint"); p.add_argument("--semantic", action="store_true")
    p.add_argument("--max", type=int, help="P1 目录预算（覆盖配置）"); p.set_defaults(fn=cmd_lint)

    sub.add_parser("drift").set_defaults(fn=cmd_drift)

    p = sub.add_parser("export"); p.add_argument("--llms-txt", action="store_true")
    p.add_argument("--summary", action="store_true",
                   help="每条附 frontmatter description（无则取首段）作为摘要")
    p.add_argument("--out"); p.set_defaults(fn=cmd_export)

    p = sub.add_parser("pdf")
    p.add_argument("src"); p.add_argument("outdir"); p.add_argument("stem")
    p.add_argument("--pdf-theme", default=""); p.add_argument("--mermaid-theme", default="")
    p.set_defaults(fn=cmd_pdf)

    return ap


def main(argv=None) -> int:
    a = build_parser().parse_args(argv)
    root = (Path(a.root).expanduser().resolve() if a.root else (_root_from_env() or find_root()))
    return a.fn(load_cfg(root, getattr(a, "port", None)), a) or 0


if __name__ == "__main__":
    sys.exit(main())
