#!/usr/bin/env python3
"""redis-cli — Redis 访问 CLI（`redis-cli` skill）

判据见 ../SKILL.md；项目配置见项目根 `.redis-cli.toml`（模板见 ../TEMPLATE.md）。

复用系统 `redis-cli`——**零第三方依赖**；口令经子进程 `env=` 注入 `REDISCLI_AUTH`
（redis-cli ≥ 5 支持，**不落 shell history、不进进程列表**）。子命令：

  ping              连通性探测（PONG 即通）
  exec <命令...>    任意 Redis 命令透传（如 `exec GET key` / `exec SET k v` / `exec DBSIZE`）
  keys <pattern>    枚举匹配键（大库请改用 `exec SCAN`）

用法：
  redis-cli [全局] <子命令> [参数]

全局：`--root DIR` · `--env-file F`（可多次）· `--host/--port/--password/--db/--timeout`
· `--json`（机器可读：数组化输出）。

项目根定位：`--root` → `REDIS_CLI_ROOT` → 向上查找 `.redis-cli.toml` → `.git`。
连接取值优先级（高→低）：命令行 → `--env-file`/进程环境 → `.redis-cli.toml [connection]` → 内置默认。
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:                      # pragma: no cover
    tomllib = None


USAGE = """用法：
  redis-cli [--root DIR] [--env-file F]... [--host H] [--port P] [--password P]
            [--db N] [--timeout N] [--json] <子命令> [参数]

子命令：
  redis-cli ping [--timeout N]                     连通性探测（PONG 即通）
  redis-cli exec <命令...> [--db N] [--json]       任意命令透传（`exec GET key` / `exec DBSIZE`）
  redis-cli keys <pattern> [--db N] [--json]       枚举匹配键（大库请改用 exec SCAN）

连接取值优先级（高→低）：命令行 → --env-file/进程环境 → .redis-cli.toml [connection] → 内置默认。
口令只经 REDISCLI_AUTH 注入子进程，不落 shell history。
"""

DEFAULTS = {"host": "127.0.0.1", "port": "6379", "password": "",
            "timeout": "8", "env_file": ""}

ENV_VARS = {"host": "REDIS_HOST", "port": "REDIS_PORT", "password": "REDIS_PASSWORD"}

CFG: dict = {"root": None}


class RedisError(RuntimeError):
    """redis-cli 调用失败或参数非法。"""


def _find_root(start: Path | None = None) -> Path:
    """向上找项目根：`.redis-cli.toml` → `.git` → 起点。"""
    cur = (start or Path.cwd()).resolve()
    for marker in (".redis-cli.toml", ".git"):
        for d in [cur, *cur.parents]:
            if (d / marker).exists():
                return d
    return cur


def _load_toml(root: Path) -> dict:
    f = root / ".redis-cli.toml"
    if not f.exists():
        return {}
    if tomllib is None:
        raise RedisError("需要 Python 3.11+ 才能解析 .redis-cli.toml")
    return tomllib.loads(f.read_text(encoding="utf-8"))


_ENV_LINE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$")


def _unquote(value: str) -> str:
    v = value.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        return v[1:-1]
    return v


def parse_env_text(text: str) -> dict[str, str]:
    """解析 shell 风格 `.env` 文本：支持 `export`、单/双引号、`#` 注释、空行。不做变量展开。"""
    out: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        m = _ENV_LINE.match(raw)
        if m:
            out[m.group(1)] = _unquote(m.group(2))
    return out


def _from_env(env: dict[str, str], names) -> str | None:
    for name in names:
        if name and env.get(name):
            return env[name]
    return None


class Context:
    def __init__(self, root: Path, cfg: dict, env_files: list[str],
                 conn_opts: dict, json_mode: bool):
        self.root = root
        self.cfg = cfg
        self.env_files = env_files
        self.conn_opts = conn_opts
        self.json = json_mode

    def _env(self) -> dict[str, str]:
        conn_cfg = self.cfg.get("connection") or {}
        merged: dict[str, str] = {}
        names: list[str] = []
        if conn_cfg.get("env_file"):
            names.append(str(conn_cfg["env_file"]))
        names += self.env_files
        for name in names:
            p = Path(name).expanduser()
            if not p.is_absolute():
                p = self.root / p
            if p.is_file():
                merged.update(parse_env_text(p.read_text(encoding="utf-8")))
        merged.update(os.environ)
        return merged

    def pick(self, key: str, default: str) -> str:
        cli = self.conn_opts.get(key)
        if cli is not None:
            return cli
        conn_cfg = self.cfg.get("connection") or {}
        var = conn_cfg.get(f"{key}_var")
        names = [var] if isinstance(var, str) else list(var or [])
        general = ENV_VARS.get(key)
        if general and general not in names:
            names.append(general)
        found = _from_env(self._env(), names)
        if found is not None:
            return found
        toml_val = conn_cfg.get(key)
        if toml_val not in (None, ""):
            return str(toml_val)
        return default

    def host(self) -> str:
        return self.pick("host", DEFAULTS["host"])

    def port(self) -> str:
        return self.pick("port", DEFAULTS["port"])

    def password(self) -> str:
        return self.pick("password", DEFAULTS["password"])

    def timeout(self, override=None) -> int:
        if override is not None:
            return int(override)
        conn_cfg = self.cfg.get("connection") or {}
        return int(self.conn_opts.get("timeout") or conn_cfg.get("timeout") or DEFAULTS["timeout"])

    def db(self) -> str | None:
        db = self.conn_opts.get("db")
        if db is None:
            conn_cfg = self.cfg.get("connection") or {}
            db = conn_cfg.get("db")
        return str(db) if db not in (None, "") else None


def redis_run(host: str, port, password: str, *args: str,
              timeout: int = 8, db: str | None = None) -> str:
    """跑 `redis-cli`，返回 stdout（strip）。失败转 `RedisError`。"""
    env = dict(os.environ)
    if password:
        env["REDISCLI_AUTH"] = password
    cmd = ["redis-cli", "-h", str(host), "-p", str(port)]
    if db is not None:
        cmd += ["-n", str(db)]
    cmd += list(args)
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise RedisError(f"连接或执行超时（{timeout}s）——目标可能不可达") from None
    if result.returncode != 0:
        raise RedisError(result.stderr.strip() or f"redis-cli 退出码 {result.returncode}")
    return result.stdout.strip()


def redis_ping(host: str, port, password: str, *, timeout: int = 8,
               db: str | None = None) -> bool:
    """`PING` → `PONG` 即通。"""
    return redis_run(host, port, password, "PING", timeout=timeout, db=db) == "PONG"


def _parse(args):
    """只分离位置参数与 `--k v` / `--k=v`（redis 命令参数一律走位置位）。"""
    pos: list[str] = []
    opts: dict = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            name = a[2:]
            if "=" in name:
                k, v = name.split("=", 1); opts[k] = v; i += 1
            elif i + 1 < len(args) and not args[i + 1].startswith("--"):
                opts[name] = args[i + 1]; i += 2
            else:
                opts[name] = True; i += 1
        else:
            pos.append(a); i += 1
    return pos, opts


def _split_globals(argv):
    root = None
    env_files: list[str] = []
    json_mode = False
    conn_opts: dict = {}
    out: list[str] = []
    keys = ("host", "port", "password", "timeout", "db")
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            json_mode = True
        elif a == "--root" and i + 1 < len(argv):
            root = argv[i + 1]; i += 1
        elif a.startswith("--root="):
            root = a.split("=", 1)[1]
        elif a == "--env-file" and i + 1 < len(argv):
            env_files.append(argv[i + 1]); i += 1
        elif a.startswith("--env-file="):
            env_files.append(a.split("=", 1)[1])
        elif a.startswith("--") and a[2:] in keys and i + 1 < len(argv):
            conn_opts[a[2:]] = argv[i + 1]; i += 1
        elif a.startswith("--") and "=" in a and a[2:].split("=", 1)[0] in keys:
            k, v = a[2:].split("=", 1); conn_opts[k] = v
        else:
            out.append(a)
        i += 1
    return root, env_files, json_mode, conn_opts, out


def cmd_ping(args, ctx: Context) -> int:
    _pos, opts = _parse(args)
    timeout = ctx.timeout(opts.get("timeout"))
    ok = redis_ping(ctx.host(), ctx.port(), ctx.password(), timeout=timeout, db=ctx.db())
    if ctx.json:
        print(json.dumps({"ok": ok, "host": ctx.host(), "port": ctx.port(), "db": ctx.db()},
                         ensure_ascii=False))
    else:
        target = f"{ctx.host()}:{ctx.port()}" + (f"/{ctx.db()}" if ctx.db() else "")
        print(f"{target} · {'PONG' if ok else '无响应'}")
    return 0 if ok else 1


def cmd_exec(args, ctx: Context) -> int:
    pos, _opts = _parse(args)
    if not pos:
        raise RedisError("用法：redis-cli exec <命令...>（如 exec GET key）")
    out = redis_run(ctx.host(), ctx.port(), ctx.password(), *pos,
                    timeout=ctx.timeout(), db=ctx.db())
    _emit(out, ctx)
    return 0


def cmd_keys(args, ctx: Context) -> int:
    pos, _opts = _parse(args)
    pattern = pos[0] if pos else "*"
    out = redis_run(ctx.host(), ctx.port(), ctx.password(), "KEYS", pattern,
                    timeout=ctx.timeout(), db=ctx.db())
    print("⚠️ KEYS 会阻塞大库；生产环境请改用 `exec SCAN`", file=sys.stderr)
    _emit(out, ctx)
    return 0


def _emit(out: str, ctx: Context) -> None:
    """`--json`：按行切成数组（redis-cli 原始输出是逐行文本）。"""
    if ctx.json:
        print(json.dumps(out.splitlines(), ensure_ascii=False, indent=2))
    else:
        print(out)


_COMMANDS = {"ping": cmd_ping, "exec": cmd_exec, "keys": cmd_keys}


def dispatch(args: list[str], ctx: Context) -> int:
    cmd, rest = args[0], args[1:]
    fn = _COMMANDS.get(cmd)
    if fn is None:
        print(f"未知命令 {cmd!r}\n{USAGE}", file=sys.stderr)
        return 2
    return fn(rest, ctx)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    root_arg, env_files, json_mode, conn_opts, rest = _split_globals(argv)

    if root_arg:
        root = Path(root_arg).expanduser().resolve()
    else:
        env = os.environ.get("REDIS_CLI_ROOT")
        root = Path(env).expanduser().resolve() if env else _find_root()
    CFG["root"] = root

    if not rest or rest[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    try:
        cfg = _load_toml(root)
        ctx = Context(root, cfg, env_files, conn_opts, json_mode)
        return dispatch(rest, ctx)
    except RedisError as exc:
        print(f"错误：{exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
