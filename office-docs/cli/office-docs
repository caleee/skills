def _find_root(start: Path | None = None) -> Path:
    """向上找项目根：`.office-docs.toml` → `.git` → 起点。"""
    cur = (start or Path.cwd()).resolve()
    for marker in (".office-docs.toml", ".git"):
        for d in [cur, *cur.parents]:
            if (d / marker).exists():
                return d
    return cur


def _load_baseline(root: Path, cli_baseline: str | None) -> str | None:
    """解析只读基线目录 → 绝对路径；空串／`-` ＝ 不设护栏。

    取值优先级：`--baseline-dir` → `OFFICE_DOCS_BASELINE` → `.office-docs.toml` 的
    `[baseline] dir` → 内置默认 `docs/report/template`。相对路径相对项目根解析。
    """
    val = cli_baseline if cli_baseline is not None else os.environ.get("OFFICE_DOCS_BASELINE")
    if val is None:
        f = root / ".office-docs.toml"
        if f.exists() and tomllib is not None:
            val = (tomllib.loads(f.read_text(encoding="utf-8")).get("baseline") or {}).get("dir")
    if val is None:
        val = DEFAULTS["baseline"]
    if not val or val == "-":
        return None
    p = Path(val).expanduser()
    return str((p if p.is_absolute() else root / p).resolve())


