        grid = _read_tsv(src)
        if ctx.dry_run or _flag(rest, "--dry-run"):
            print("[dry-run] 将给 %s 写 %d 行" % (ref, len(grid)))
            return 0
        res = fill_table(rest[0], ref, grid,
                              start_row=int(_opt(rest, "--start-row") or 0),
                              out=_opt(rest, "--out"), force=_flag(rest, "--force"))
        _print(res, ctx, lambda: print("%s ← %s 写入 %d 格（未写 %d）%s" % (
            res["file"], res["ref"], res["cells"], res["skipped"],
            "，备份 " + res["backup"] if res["backup"] else "")))
        return 0

    if cmd == "del-shape":
        if not rest:
            print(USAGE)
            return 2
        ref = _opt(rest, "--at")
        if not ref:
            print("错误：del-shape 需要 --at <ref>（`slideN!sp[i]`／`gf[i]`／`pic[i]`）")
            return 2
        if ctx.dry_run or _flag(rest, "--dry-run"):
            print("[dry-run] 将删除 %s" % ref)
            return 0
        res = del_shape(rest[0], ref, out=_opt(rest, "--out"), force=_flag(rest, "--force"))
        _print(res, ctx, lambda: print("%s ← 已删除 %s（%d 字符）%s" % (
            res["file"], res["removed"], res["chars"],
            "，备份 " + res["backup"] if res["backup"] else "")))
        return 0

    if cmd == "media":
        if not rest:
            print(USAGE)
            return 2
        items = media(rest[0])
        _print(items, ctx, lambda: print("\n".join(
            f"{x['name']:<24} {x['bytes']:>8}B  {x['size']:<10}  used_by: {x['used_by'] or '—'}"
            for x in items) or "（无媒体）"))
        return 0

    if cmd == "put-image":
        if not rest:
            print(USAGE)
            return 2
        path, at, frm = rest[0], _opt(rest, "--at"), _opt(rest, "--from")
        if not at or not frm:
            print("错误：put-image 需要 --at <imageN.png> 与 --from <源图>")
            return 2
        if ctx.dry_run or _flag(rest, "--dry-run"):
            print(f"[dry-run] 将把 {at} 替成 {frm}")
            return 0
        res = put_image(path, at, frm, out=_opt(rest, "--out"), force=_flag(rest, "--force"))
        _print(res, ctx, lambda: print(
            f"{res['file']} ← {res['target']}（{res['bytes']}，used_by {res['used_by'] or '—'}）"
            + (f"，备份 {res['backup']}" if res["backup"] else "")
            + (f"\n⚠ {res['aspect_warn']}" if res["aspect_warn"] else "")))
        return 0

    if cmd == "check":
        if not rest:
            print(USAGE)
            return 2
        path = rest[0]
        problems = check(path)
        rnd = render(path, out=_opt(rest, "--render-out")) if _flag(rest, "--render") else None

        def human():
            print("\n".join(problems) if problems
                  else "自检通过（条目唯一／zip 完整／XML 良构）")
            if rnd is None:
                return
            if rnd["ok"]:
                extra = f"，导出 {rnd['pages']} 页 PDF" if rnd.get("pages") else ""
                print(f"渲染校验：PowerPoint 打开成功{extra} → {rnd['pdf']}")
            elif rnd["unavailable"]:
                print(f"渲染校验：跳过（{rnd['reason']}）")
            else:
                print(f"渲染校验：失败——{rnd['reason']}")

        _print({"problems": problems, "render": rnd}, ctx, human)
        if problems:
            return 1
        if rnd is None or rnd["ok"]:
            return 0
        return 2 if rnd["unavailable"] else 1

    print(f"未知子命令 {cmd}\n\n{USAGE}")
    return 2


def _style_brief(s: dict) -> str:
    """样式摘要：底/字/字号/bold/字体/框（四边存在哪几边）。"""
    if not s:
        return ""
    parts = []
    if s.get("fill"):
        parts.append("底" + s["fill"])
    f = s.get("font") or {}
    if f.get("color"):
        parts.append("字" + f["color"])
    if f.get("sz"):
        parts.append(f"{f['sz']:g}pt")
    if f.get("b"):
        parts.append("bold")
    if f.get("name"):
        parts.append(f["name"])
    sides = "".join(k for k in "lrtb" if (s.get("border") or {}).get(k))
    if sides:
        parts.append("框" + sides)
    return "[" + " ".join(parts) + "]"


def _dump_xlsx_human(d: dict) -> None:
    print(f"{d['file']} :: {d['sheet']}  {d['dimension']}  合并 {len(d['merged'])} 处")
    if d["cols"]:
        print("  列宽:", ", ".join(f"{c['min']}–{c['max']}={c['width']}" for c in d["cols"]))
    for row in d["rows"]:
        cells = " ".join(
            f"{c['ref']}「{c['text']}」{_style_brief(c['style'])}" for c in row["cells"] if c["text"])
        print(f"  r{row['r']} h={row['h']}: {cells}")
    if d["merged"]:
        print("  合并:", "、".join(d["merged"]))


def _dump_md_tables(src: str, tables: list[dict]) -> None:
    print(f"{os.path.basename(src)} 共 {len(tables)} 个表格")
    for t in tables:
        note = f"  列数不齐 {t['ragged']} 行已补空" if t["ragged"] else ""
        print(f"  {t['index']}. 第 {t['line']} 行 · {t['cols']} 列 · {len(t['rows'])} 数据行{note}")
        print(f"     表头: {' / '.join(t['header'][:8])}")


def xlsx_main(args: list[str], ctx: Context) -> int:
    if not args or args[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    cmd, rest = args[0], args[1:]
    if cmd == "dump":
        if not rest:
            print(USAGE)
            return 2
        idx = _opt(rest, "--index")
        d = xlsx_dump(rest[0], _opt(rest, "--sheet"),
                      index=int(idx) if idx else None, show_empty=_flag(rest, "--all"))
        _print(d, ctx, lambda: _dump_xlsx_human(d))
        return 0
    if cmd == "from-md":
        if not rest:
            print(USAGE)
            return 2
        src = rest[0]
        if not os.path.isfile(src):
            print(f"错误：文件不存在：{src}", flush=True)
            return 2
        with open(src, encoding="utf-8") as f:
            tables = parse_md_tables(f.read())
        if not tables:
            print(f"{src}：没有解析到管道表格", flush=True)
            return 1
        if _flag(rest, "--list"):
            _dump_md_tables(src, tables)
            return 0
        out = _opt(rest, "--out")
        if not out:
            print("错误：from-md 需要 --out <目标.xlsx>（只想看表格用 --list）", flush=True)
            return 2
        pick = _opt(rest, "--table")
        try:
            idx = int(pick) if pick else 1
        except ValueError:
            print(f"错误：--table 需为序号（收到 {pick!r}）", flush=True)
            return 2
        if not 1 <= idx <= len(tables):
            print(f"错误：{src} 只有 {len(tables)} 个表格（--table 1..{len(tables)}）", flush=True)
            return 2
        t = tables[idx - 1]
        try:
            res = write_table(out, t["header"], t["rows"],
                                   sheet_name=_opt(rest, "--sheet") or "Sheet1",
                                   force=_flag(rest, "--force"))
        except XlsxError as e:
            print(f"错误：{e}", flush=True)
            return 2
        _print(res, ctx, lambda: print(
            f"{res['file']} :: {res['sheet']}  {res['rows']} 行 × {res['cols']} 列  "
            f"{res['bytes']} 字节  ← {os.path.basename(src)} 第 {t['index']} 个表格"))
        return 0
    print(f"未知子命令 {cmd}\n\n{USAGE}")
    return 2


def dispatch(args: list[str], ctx: Context) -> int:
    if not args or args[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    if args[0] == "pptx":
        return pptx_main(args[1:], ctx)
    if args[0] == "xlsx":
        return xlsx_main(args[1:], ctx)
    print(f"未知子域 {args[0]!r}\n\n{USAGE}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
