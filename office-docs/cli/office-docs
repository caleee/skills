        if ctx.dry_run or _flag(rest, "--dry-run"):
            cur = text_map(path).get(ref) or "（空目标）"
            print(f"[dry-run] {ref}\n  旧: {cur}\n  新: {text}")
            return 0
        res = set_text(path, ref, text, run=int(run) if run is not None else None,
                            merge=_flag(rest, "--merge"), out=_opt(rest, "--out"),
                            force=_flag(rest, "--force"))
        _print(res, ctx, lambda: print(
            f"{res['file']} ← {res['ref']}（{res['runs']} run）"
            + (f"，备份 {res['backup']}" if res["backup"] else "")
            + "\n" + "\n".join(f"  run{f['run']} 旧: {f['old']}\n         新: {f['new']}"
                               for f in res["changed"])))
        return 0

    if cmd == "diff":
        if len(rest) < 2:
            print(USAGE)
            return 2
        changes = diff(rest[0], rest[1])
        _print(changes, ctx, lambda: print("\n".join(
            f"{c['ref']}\n  旧: {c['old']}\n  新: {c['new']}" for c in changes) or "（无文字差异）"))
        return 0

    if cmd == "add-slide":
        if not rest:
            print(USAGE)
            return 2
        layout = int(_opt(rest, "--layout") or 1)
        if ctx.dry_run or _flag(rest, "--dry-run"):
            print("[dry-run] 将新增一页空白页（layout %d）" % layout)
            return 0
        res = add_slide(rest[0], layout=layout, out=_opt(rest, "--out"),
                             force=_flag(rest, "--force"))
        _print(res, ctx, lambda: print("%s ← 新增 slide%d（layout%d，共 %d 页）%s" % (
            res["file"], res["slide"], res["layout"], res["total_slides"],
            "，备份 " + res["backup"] if res["backup"] else "")))
        return 0

    if cmd == "add-table":
        if not rest:
            print(USAGE)
            return 2
        path, src, ref = rest[0], _opt(rest, "--from"), _opt(rest, "--range")
        if not src or not ref:
            print("错误：add-table 需要 --from <xlsx> 与 --range <区域>（如 B4:AB6）")
            return 2
        at = [s for s in (_opt(rest, "--at") or "").split(",") if s]
        size = [s for s in (_opt(rest, "--size") or "").split(",") if s]
        x_pt = float(at[0]) if len(at) == 2 else 40.0
        y_pt = float(at[1]) if len(at) == 2 else 40.0
        w_pt, h_pt = (float(size[0]), float(size[1])) if len(size) == 2 else (None, None)
        slide = int(_opt(rest, "--slide") or 1)
        sheet = _opt(rest, "--sheet")
        idx = _opt(rest, "--index")
        index = int(idx) if idx else None
        if ctx.dry_run or _flag(rest, "--dry-run"):
            info = grid(src, sheet, ref, index)
            print("[dry-run] 将把 %s!%s 的 %d×%d 表（合并 %d）放至 slide%d @(%.0f,%.0f)pt"
                  % (src, info["sheet"], info["rows"], info["cols_n"], len(info["merged"]),
                     slide, x_pt, y_pt))
            return 0
        res = add_table(path, xlsx_path=src, ref=ref, sheet=sheet, index=index, slide=slide,
                             x_pt=x_pt, y_pt=y_pt, w_pt=w_pt, h_pt=h_pt,
                             out=_opt(rest, "--out"), force=_flag(rest, "--force"))
        _print(res, ctx, lambda: print(
            "%s ← slide%d 新增表格 %d×%d（合并 %d），%.0f×%.0fpt%s"
            % (res["file"], res["slide"], res["rows"], res["cols"], res["merged"],
               res["w_pt"], res["h_pt"], "，备份 " + res["backup"] if res["backup"] else "")))
        return 0

    if cmd == "move-shape":
        if not rest:
            print(USAGE)
            return 2
        ref = _opt(rest, "--at")
        to = [v for v in (_opt(rest, "--to") or "").split(",") if v]
        by = [v for v in (_opt(rest, "--by") or "").split(",") if v]
