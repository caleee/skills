            print("错误：copy-shape 需要 --at <ref>（`slideN!sp[i]`）")
            return 2
        to = [v for v in (_opt(rest, "--to") or "").split(",") if v]
        kw = {"x_pt": float(to[0]), "y_pt": float(to[1])} if len(to) == 2 else {}
        ts = _opt(rest, "--to-slide")
        if ts:
