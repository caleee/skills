        _print(res, ctx, lambda: print("%s ← 已克隆 %s → slide%d（新 id=%d）%s" % (
            res["file"], res["cloned_from"], res["to_slide"], res["new_id"],
            "，备份 " + res["backup"] if res["backup"] else "")))
        return 0

    if cmd == "add-shape":
        if not rest:
            print(USAGE)
            return 2
        at = [v for v in (_opt(rest, "--at") or "").split(",") if v]
        size = [v for v in (_opt(rest, "--size") or "").split(",") if v]
        if len(at) != 2 or len(size) != 2:
            print("错误：add-shape 需要 --at x,y 与 --size w,h")
            return 2
        kw = {"x_pt": float(at[0]), "y_pt": float(at[1]), "w_pt": float(size[0]), "h_pt": float(size[1]),
