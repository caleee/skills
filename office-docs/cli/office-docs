        if ctx.dry_run or _flag(rest, "--dry-run"):
            print("[dry-run] 在 slide%s 新建形状：%s" % (kw["slide"], kw))
            return 0
        res = add_shape(rest[0], **kw)
        _print(res, ctx, lambda: print("%s ← slide%d 新建形状 %s @(%d,%d) %dx%d" % (
            res["file"], res["slide"], res["at"], res["at"]["x"], res["at"]["y"], res["at"]["w"], res["at"]["h"])))
        return 0

    if cmd == "add-connector":
        if not rest:
            print(USAGE)
            return 2
        fr = [v for v in (_opt(rest, "--from") or "").split(",") if v]
        to = [v for v in (_opt(rest, "--to") or "").split(",") if v]
